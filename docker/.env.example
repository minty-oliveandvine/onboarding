# Onboarding frontend — local environment.
# Copy to `.env` (in this docker/ folder) before running docker compose:
#   cp .env.example .env
#
# All values below are safe local defaults. The orchestrator overrides these
# when running the full stack together.

# Base URL of the pettycash (Flask) backend that the onboarding frontend calls.
# This is the primary variable used across the app.
NEXT_PUBLIC_MODULE1_API_URL=http://localhost:5001

# Legacy fallback still read by the auth pages. Keep it pointed at the same
# backend as NEXT_PUBLIC_MODULE1_API_URL.
NEXT_PUBLIC_API_URL=http://localhost:5001

# Base URL of the extracted onboarding API (the Django service, ../onboarding-backend).
#
# The wizard's /api/onboarding/* calls go here; /auth/email/*, /legal/*, /xero_auth,
# /xero_connect, /logout and /entity still go to the Flask app above. Which service
# answers which path is decided in one place -- lib/apiRoutes.js.
#
# Unset falls back to http://localhost:8001, which is what the service's docker image
# and `manage.py runserver` both use. In a deployed environment LEAVE IT SET: an unset
# NEXT_PUBLIC_* var is inlined at build time as the localhost default, which is the
# exact failure NEXT_PUBLIC_API_URL caused before (see lib/flaskBase.js).
NEXT_PUBLIC_ONBOARDING_API_URL=http://localhost:8001
